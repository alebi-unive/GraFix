                    "wl": 5,
                    "layers": 2,
                    "hop": 3,
                    "C": 32,
                    "dropout": 0.2,
                    "lr": 0.001
                },
                "asymmetric": {
                    "hidden": 128,
                    "wl": 5,
                    "layers": 1,
                    "hop": 3,
                    "C": 32,
                    "dropout": 0.0,
                    "lr": 0.001
