{
    "common": {
        "seed": 42,
        "split_index": 0,
        "epochs": 1000,
        "patience": 200,
        "numheads": 1,
        "GL_k": 5,
        "batch_size": 32,
        "kernels": "WL"
    },
    "gate_activations": [
        "sigmoid",
        "tanh_shifted",
        "relu",
        "softplus",
        "tanh_abs"
